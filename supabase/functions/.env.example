# Edge Function runtime secrets.
#
# This file is the authoritative list of env vars read by Supabase Edge
# Functions in this project. CI (deploy-beta.yml, deploy-production.yml)
# reconciles these to GitHub Secrets on every deploy.
#
# For local development, copy this file to .env / .env.staging and fill
# values in. Do NOT commit .env / .env.staging — they are gitignored.

# --- Cloudflare R2 (object storage) ---
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_DOMAIN=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Webapp ---
# Base URL of the user-facing webapp, no trailing slash. The payout-setup
# function appends /stripe/connect/{return,refresh} to construct Stripe
# Connect onboarding URLs.
WEB_BASE_URL=

# --- Firebase Admin SDK (FCM push notifications) ---
# Service account JSON for the Firebase project the app is wired to,
# minified to a single line. Get from Firebase Console > Project Settings
# > Service accounts.
# Required role: Firebase Cloud Messaging (FCM Sender).
FIREBASE_SERVICE_ACCOUNT_JSON='{"type": "service_account", "project_id": "...", ...}'

# --- Google Play Developer API (subscription verification) ---
# Service account JSON for the Google Cloud project that owns the Play
# Developer API access, minified to a single line. Used by
# handle-google-play-rtdn to fetch subscription details via
# androidpublisher v3.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON='{"type": "service_account", "project_id": "...", ...}'

# --- Google Pub/Sub (RTDN push validation) ---
# Used by handle-google-play-rtdn to validate the OIDC token attached
# to incoming Pub/Sub push messages.
# AUDIENCE: the full edge function URL the push subscription targets
#   (e.g. https://<project-ref>.supabase.co/functions/v1/handle-google-play-rtdn).
# SERVICE_ACCOUNT_EMAIL: the service account configured as the push
#   subscription's authentication identity.
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=

# --- Operator-only auth ---
# Shared secret for operator-initiated calls to recommend-payout-topup.
# Generate with: openssl rand -hex 32
# Passed by the operator's external task tool in the X-Operator-Secret
# HTTP header.
OPERATOR_AUTH_TOKEN=
