# Google Sign-In: comma-separated client IDs, WEB client first, then iOS.
# GoTrue validates the native id_token `aud` against this list.
GOOGLE_CLIENT_ID=
# Web client secret (used by the webapp browser OAuth flow, not native mobile;
# optional for native-only sign-in). From Firebase Console -> Authentication ->
# Sign-in method -> Google -> "Web SDK configuration".
GOOGLE_CLIENT_SECRET=

