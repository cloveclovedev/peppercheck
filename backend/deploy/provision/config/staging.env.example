# Copy to config/staging.env (gitignored, chmod 0600) and fill in.
# --- bootstrap provider tokens (write-capable; used by this script) ---
DO_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
BETTERSTACK_API_TOKEN=
TS_API_KEY=
BWS_WRITE_TOKEN=
# --- values obtained at manual gates ---
GHCR_TOKEN=
BWS_RUNTIME_TOKEN=
BWS_PROJECT_ID=
BWS_RESTORE_PROJECT_ID=
FIREBASE_TEST_API_KEY=
FIREBASE_TEST_EMAIL=
FIREBASE_TEST_PASSWORD=
