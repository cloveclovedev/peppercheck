PUBLIC_DOMAIN=staging.peppercheck.dev
SSH_HOST=pc-staging
TS_TAG=tag:pc-staging
DO_REGION=sgp1
DO_SIZE=s-1vcpu-1gb
FIREBASE_PROJECT_ID=
API_PORT=8765
B2_BUCKET=
B2_REGION=
