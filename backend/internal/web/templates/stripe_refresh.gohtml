{{define "content"}}
<div>
<h1>{{t .Locale "StripeConnect.refresh.title"}}</h1>
<p>{{t .Locale "StripeConnect.refresh.description"}}</p>
<p>{{t .Locale "StripeConnect.refresh.note"}}</p>
<p>{{replace (t .Locale "StripeConnect.refresh.contact") "{email}" (t .Locale "Meta.contactEmail")}}</p>
</div>
{{end}}
