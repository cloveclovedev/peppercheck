# GitHub Secrets for peppercheck CI/CD
# Copy this file to scripts/github-secrets and fill in the values.
#
# Text secrets are set from this file via scripts/setup-github-secrets.sh
# Binary/file secrets are set separately (see instructions below).

# --- Supabase ---
# Access token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Beta project: Supabase Dashboard > Beta project > Settings > General
BETA_SUPABASE_PROJECT_ID=
BETA_SUPABASE_DB_PASSWORD=
# Beta project: Supabase Dashboard > Beta project > Settings > API > publishable key
BETA_SUPABASE_PUBLISHABLE_KEY=

# Production project: same as above for production project
PROD_SUPABASE_PROJECT_ID=
PROD_SUPABASE_DB_PASSWORD=
PROD_SUPABASE_PUBLISHABLE_KEY=

# --- Stripe (Flutter / webapp side: publishable keys) ---
# Stripe Dashboard > Test mode > API keys > Publishable key
BETA_STRIPE_PUBLISHABLE_KEY=
# Stripe Dashboard > Live mode > API keys > Publishable key
PROD_STRIPE_PUBLISHABLE_KEY=

# --- Stripe (Edge Function side: secret + webhook keys) ---
# Stripe Dashboard > Test mode > API keys > Secret key
BETA_STRIPE_SECRET_KEY=
# Stripe Dashboard > Live mode > API keys > Secret key
PROD_STRIPE_SECRET_KEY=
# Stripe Dashboard > Webhooks > pick the endpoint pointing at the BETA
#   Supabase project's handle-stripe-webhook > Signing secret
BETA_STRIPE_WEBHOOK_SECRET=
# Stripe Dashboard > Webhooks > production endpoint > Signing secret
PROD_STRIPE_WEBHOOK_SECRET=

# --- Cloudflare R2 (object storage for evidence uploads) ---
# R2 bucket name (e.g. peppercheck-staging / peppercheck)
BETA_R2_BUCKET_NAME=
PROD_R2_BUCKET_NAME=
# R2 access key pair: Cloudflare Dashboard > R2 > Manage R2 API Tokens
BETA_R2_ACCESS_KEY_ID=
BETA_R2_SECRET_ACCESS_KEY=
PROD_R2_ACCESS_KEY_ID=
PROD_R2_SECRET_ACCESS_KEY=
# R2 public CDN domain (e.g. https://r2.peppercheck.dev)
BETA_R2_PUBLIC_DOMAIN=
PROD_R2_PUBLIC_DOMAIN=

# --- Webapp base URL (used by payout-setup edge function) ---
BETA_WEB_BASE_URL=https://staging.peppercheck.dev
PROD_WEB_BASE_URL=https://peppercheck.dev

# --- Operator-only auth ---
# Shared secret for operator-initiated calls to recommend-payout-topup.
# Generate per env with: openssl rand -hex 32
BETA_OPERATOR_AUTH_TOKEN=
PROD_OPERATOR_AUTH_TOKEN=

# --- Google Pub/Sub (RTDN push validation) ---
# AUDIENCE: full edge function URL the Play push subscription targets.
#   Format: https://<supabase-project-ref>.supabase.co/functions/v1/handle-google-play-rtdn
# SERVICE_ACCOUNT_EMAIL: the service account configured as the push
#   subscription's auth identity.
# BETA values: copy from PROD until Phase 2 #430 creates the staging
#   RTDN topic.
BETA_GOOGLE_PUBSUB_AUDIENCE=
BETA_GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=
PROD_GOOGLE_PUBSUB_AUDIENCE=
PROD_GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=

# --- Android signing (Flutter CI) ---
# Values from when the upload keystore was created
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=
ANDROID_KEY_ALIAS=

# --- Cloudflare ---
# Cloudflare Dashboard > My Profile > API Tokens (needs Workers Scripts:Edit)
CLOUDFLARE_API_TOKEN=
# Cloudflare Dashboard > right sidebar > Account ID
# Shared across all environments (one Cloudflare account).
CLOUDFLARE_ACCOUNT_ID=

# --- Binary/file secrets (not in this file, set separately) ---
#
# Each file-style secret is set via its own gh secret set command. The
# Phase 1 Firebase-per-flavor and App Distribution secrets can be set in
# one shot by scripts/setup/setup-deploy-secrets.sh after the staging
# service account has been provisioned via
# scripts/setup/bootstrap-peppercheck-staging-sa.sh.
#
# Single-line constraint: every Firebase / Google Cloud service account
# JSON used by Edge Functions or by Supabase secret-set steps MUST be
# flattened to a single line via `jq -c`. The deploy workflows write
# these values into env files, and the env-file parser only accepts one
# line per variable. A multi-line value silently breaks JSON.parse in
# send-notification at runtime.
#
# === Android upload keystore ===
#
# ANDROID_KEYSTORE_BASE64:
#   base64 < /path/to/upload-keystore.jks | gh secret set ANDROID_KEYSTORE_BASE64
#
# === Per-flavor google-services.json (Phase 1, Android only) ===
#
# Multi-line is OK here — the workflow writes the value directly to a
# JSON file (`echo '${{ secrets.X }}' > .../google-services.json`), not
# into an env file. Using jq -c is also fine for consistency.
#
# BETA_GOOGLE_SERVICES_JSON (staging Android build):
#   gh secret set BETA_GOOGLE_SERVICES_JSON < peppercheck_flutter/android/app/src/staging/google-services.json
#
# PROD_GOOGLE_SERVICES_JSON (production Android build):
#   gh secret set PROD_GOOGLE_SERVICES_JSON < peppercheck_flutter/android/app/src/production/google-services.json
#
# === Firebase App Distribution + FCM service accounts (per-env) ===
#
# After Phase 1 each environment has its own Firebase project, and a
# single service account per project carries both FAD admin and FCM
# sender roles (used by deploy-beta.yml's google-github-actions/auth@v2
# step and by send-notification at Edge Function runtime).
#
# BETA_FIREBASE_SERVICE_ACCOUNT_JSON:
#   jq -c . < /path/to/peppercheck-staging-sa.json | gh secret set BETA_FIREBASE_SERVICE_ACCOUNT_JSON
#   (Roles: roles/firebaseappdistro.admin + roles/firebasecloudmessaging.admin
#    on the peppercheck-staging Firebase project.)
#
# PROD_FIREBASE_SERVICE_ACCOUNT_JSON:
#   jq -c . < /path/to/peppercheck-sa.json | gh secret set PROD_FIREBASE_SERVICE_ACCOUNT_JSON
#   (Roles: roles/firebasecloudmessaging.admin on the peppercheck
#    production Firebase project. FAD is staging-only today.)
#
# BETA_FIREBASE_APP_ID (FAD app ID for staging Android app):
#   Auto-resolved by scripts/setup/setup-deploy-secrets.sh via
#   `firebase apps:list --project peppercheck-staging`. To set manually:
#     gh secret set BETA_FIREBASE_APP_ID --body "1:NNNNNNN:android:HEX"
#
# === Google Play Developer API service accounts (per-env) ===
#
# BETA_GOOGLE_PLAY_SERVICE_ACCOUNT_JSON, PROD_GOOGLE_PLAY_SERVICE_ACCOUNT_JSON
# (handle-google-play-rtdn edge function):
#   jq -c . < /path/to/play-developer-sa.json | gh secret set BETA_GOOGLE_PLAY_SERVICE_ACCOUNT_JSON
#   jq -c . < /path/to/play-developer-sa.json | gh secret set PROD_GOOGLE_PLAY_SERVICE_ACCOUNT_JSON
#   (Google Cloud Console > IAM > Service Accounts > Create key > JSON.
#    Required: Play Console > API access link the service account to the
#    app, grant subscription view permissions.)
#   (BETA: copy the same JSON as PROD until Phase 2 #430 lands.)
